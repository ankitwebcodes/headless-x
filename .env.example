# ================= Database =================
# Vercel: set to your Vercel Postgres / Neon connection string (postgres://...)
# Local dev: leave EMPTY -> SQLite file (xpanel.db)
# DATABASE_URL=

# ================= Auth =================
# AUTH_SECRET=  <- set a long random string in Vercel; local dev falls back to a dev secret

# ================= Media storage =================
# BLOB_READ_WRITE_TOKEN=  <- Vercel Blob token (prod). Local dev saves under ./public/uploads

# ================= Worker bridge =================
# WORKER_TOKEN=  <- shared secret; must match worker/config.json

# ================= App =================
# PUBLIC_BASE_URL=  <- deployed app URL (optional)
